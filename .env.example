# Copy to .env and fill in. Used by docker-compose.yml.

# ── Soulseek account ─────────────────────────────────────────────────────────
# Free to create at https://www.slsknet.org/
SOULSEEK_USERNAME=your_soulseek_username
SOULSEEK_PASSWORD=your_soulseek_password

# ── slskd API key ────────────────────────────────────────────────────────────
# Any random string, 16-255 characters. Generate one with:
#   openssl rand -hex 32
SLSKD_API_KEY=replace_me_with_a_random_string_at_least_16_chars

# ── Paths and ports ──────────────────────────────────────────────────────────
# Where downloaded music is stored on the host.
MUSIC_PATH=./downloads

# Port the web UI listens on.
WEB_PORT=8080

# Soulseek peer port. Forward this in your router for reliable transfers.
SOULSEEK_LISTEN_PORT=50300

TZ=UTC

# ── Optional: password-protect the web UI ────────────────────────────────────
# Leave empty for no login (fine on a trusted LAN). Set it if the UI is
# reachable from the internet. Can also be set later in Settings.
APP_PASSWORD=

# ── Running against an slskd you already have ────────────────────────────────
# Not used by docker-compose; these are read directly by the app if you run it
# without the bundled slskd service.
# SLSKD_URL=http://localhost:5030
